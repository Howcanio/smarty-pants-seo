---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page does not exist. Find Smarty Pants models, prices, Mac guides and how to earn with an idle Apple silicon Mac.">
  <section class="hero">
    <div class="container hero-solo">
      <p class="eyebrow">404</p>
      <h1>Not smart enough to find that page</h1>
      <p class="lead">The link may be old. Here is where to go next.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/ai-models/">See the models</a>
        <a class="btn btn-secondary btn-lg" href="/earn/">Earn with your Mac</a>
        <a class="btn btn-secondary btn-lg" href="/guides/">Guides</a>
      </div>
    </div>
  </section>
</BaseLayout>
