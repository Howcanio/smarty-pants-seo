---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { SITE, OWNER_OFFER, GUIDE_LINKS, API_ACCESS, API_ACCESS_TEXT, MAC_ACCESS_TEXT } from '../data/site';
import { MODELS, modelHref } from '../data/models';
import { MACS, macHref } from '../data/macs';

const title = 'Smarty Pants: open AI models on idle Apple silicon Macs';
const description = 'Built for AI agents: open models, Linux workspaces and the Macs you already own, in one account. Free on your own Macs; Mac owners paid in dollars while ready.';
const faqs = [
  { q: 'What is Smarty Pants?', a: 'Smarty Pants (smartypants.network) is a distributed inference network powered by independently owned Macs: Apple silicon Macs that owners make available when they are idle. Developers send requests to pinned, quantized builds of open AI models through an OpenAI-compatible API and pay per token; Mac owners get paid for the hours their Mac is ready.' },
  { q: 'Who can use Smarty Pants today?', a: `${API_ACCESS_TEXT[API_ACCESS]} ${MAC_ACCESS_TEXT}` },
  { q: 'What can I run on Smarty Pants?', a: 'Chat models, embeddings, reranking, short video clips and half-price batches, through an OpenAI-compatible API; speech to text and pictures are in testing. Agent workspaces (code runs, whole jobs, fleets, saves and failover) are free on your own or your Group\'s Macs; paid use on other people\'s Macs is on Smarty Pants\' own account first.' },
  { q: 'Who should not use Smarty Pants?', a: 'Anyone who needs a frontier-size model, more context than a model lists, strict latency guarantees, or to send confidential data on a shared network. Requests run on Macs other people own; companies can keep work on their own Macs with a Group.' },
  { q: 'How much can a Mac earn?', a: `${OWNER_OFFER.line} ${OWNER_OFFER.conditions} It needs an Apple silicon Mac with 16 GB of memory or more. Electricity and internet are the owner's costs.` },
];
const featured = MODELS.slice(0, 6);
const chips = MACS.filter((c) => ['m4', 'm4-pro', 'm4-max', 'm5', 'm5-pro', 'm3-ultra'].includes(c.slug));
---
<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Your intelligence network</p>
        <h1>Open AI models, served by real Macs.</h1>
        <p class="lead">Smarty Pants is built for AI agents: open models, sealed Linux workspaces and the Macs you already own, under one account. Use on your own or your Group's Macs is free. On Macs other people own, developers keep the OpenAI SDK and pay per token. Mac owners are paid in dollars for the hours their Mac is ready, not only for work it serves.</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="/inference/">Use the API</a>
          <a class="btn btn-secondary btn-lg" href="/earn/">Earn with your Mac</a>
        </div>
        <ul class="checks"><li>OpenAI-compatible</li><li>Pinned model builds</li><li>Priced per token</li></ul>
      </div>
      <div class="hero-card">
        <p><small>Change two lines</small></p>
        <pre><code>{`client = OpenAI(
  base_url="${SITE.apiBase}",
  api_key=KEY)
client.chat.completions.create(
  model="smartypants/qwen3.5-9b",
  messages=[{"role": "user",
             "content": "Hi!"}])`}</code></pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>For developers</h2>
        <p>Chat and embeddings today; speech to text and image making in testing; sandboxed code runs for agents on Smarty Pants' own account first. Each page says plainly what works today and what is planned.</p>
      </div>
      <div class="grid grid-3">
        <a class="card card-link" href="/inference/"><h3 class="card-title">LLM inference API</h3><p>Pinned builds of open models through an OpenAI-compatible API, priced per token.</p><span class="arrow">How it works →</span></a>
        <a class="card card-link" href="/pricing/"><h3 class="card-title">Pricing</h3><p>Every product's price next to the cheapest and median seller elsewhere. Your own Macs are free.</p><span class="arrow">See prices →</span></a>
        <a class="card card-link" href="/compare/"><h3 class="card-title">Compare</h3><p>Against OpenRouter, Together AI, E2B, Daytona, Modal and GitHub's macOS runners, with what each does better.</p><span class="arrow">Compare →</span></a>
        <a class="card card-link" href="/inference/embeddings-api/"><h3 class="card-title">Embeddings API</h3><p>Qwen3 Embedding 0.6B for search and matching.</p><span class="arrow">Embeddings →</span></a>
        <a class="card card-link" href="/inference/batch-api/"><h3 class="card-title">Batch API</h3><p>Half-price model calls, results within 24 hours, in OpenAI's batch format.</p><span class="arrow">Batches →</span></a>
        <a class="card card-link" href="/workspaces/"><h3 class="card-title">Agent workspaces <StatusBadge status="invite" /></h3><p>A sealed Linux VM per agent job: code, tests, files, coding agents, fleets. Free on your own Macs.</p><span class="arrow">Workspaces →</span></a>
        <a class="card card-link" href="/groups/"><h3 class="card-title">Groups <StatusBadge status="invite" /></h3><p>Pool your team's own Macs. Members use them for AI for free, and private work stays on them.</p><span class="arrow">Groups →</span></a>
        <a class="card card-link" href="/inference/video-generation/"><h3 class="card-title">Video and pictures</h3><p>Short 480p clips with Wan 2.2 at $0.0125 each; pictures with FLUX.1 schnell in testing.</p><span class="arrow">Video →</span></a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2>Models</h2>
        <p>Every model is a named build of an open model, served on Macs with enough memory for it.</p>
      </div>
      <div class="grid grid-3">
        {featured.map((m) => (
          <a class="card card-link" href={modelHref(m)}>
            <h3 class="card-title">{m.shortName}</h3>
            <p>{m.short}</p>
            <p class="card-meta">{m.priceText}</p>
            <p class="card-meta"><StatusBadge status={m.status} /></p>
          </a>
        ))}
      </div>
      <p class="stack-top"><a class="text-link" href="/ai-models/">All {MODELS.length} models →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="text-block">
        <h2>For Mac owners</h2>
        <p>Smarty Pants pays for each eligible Mac that sits idle and ready. {OWNER_OFFER.line} {OWNER_OFFER.conditions} You need an Apple silicon Mac with 16 GB of memory or more; electricity and internet are your costs.</p>
        <p>Pause any time. The app pauses itself for heat, memory pressure and, on MacBooks, battery, and it does not ask for macOS permission to read your protected folders, record your screen or control your Mac.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/earn/">How earning works</a>
          <a class="btn btn-secondary" href={SITE.ownerCtaUrl}>Check my Mac</a>
        </div>
      </div>
      <div>
        <h3>Find your chip</h3>
        <ul class="related-list">
          {chips.map((c) => <li><a href={macHref(c)}>{c.name}</a></li>)}
          <li><a href="/macs/">All chips, M1 to M6</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Guides</h2>
      <ul class="related-list">{GUIDE_LINKS.map((g) => <li><a href={g.href}>{g.label}</a></li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container text-block"><Faq faqs={faqs} /></div>
  </section>
  <CtaBand />
</BaseLayout>
