---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Smarty Pants home"><Logo /></a>
    <nav class="nav" aria-label="Primary">
      <ul>{NAV.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}</ul>
    </nav>
    <a class="btn btn-yellow btn-sm header-cta" href={SITE.coreSite}>smartypants.network</a>
    <details class="mobile-nav">
      <summary aria-label="Menu"><span class="burger" aria-hidden="true"></span></summary>
      <div class="mobile-panel">
        <ul>{NAV.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}</ul>
        <a class="btn btn-primary" href={SITE.coreSite}>Go to smartypants.network</a>
      </div>
    </details>
  </div>
</header>
